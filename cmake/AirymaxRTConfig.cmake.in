# AirymaxRTConfig.cmake.in - AirymaxRT package configuration template.
# Generated into <build>/AirymaxRTConfig.cmake by configure_package_config_file().
#
# Usage from a downstream project:
#   find_package(AirymaxRT CONFIG REQUIRED)
#   target_link_libraries(my_target PRIVATE AirymaxRT::atoms)
#
# AirymaxRT atoms is a header-only INTERFACE library; headers are installed
# under ${PACKAGE_PREFIX_DIR}/include/agentrt.

@PACKAGE_INIT@

set(AirymaxRT_VERSION "@PROJECT_VERSION@")

# Include directories for the header-only atoms interface.
set_and_check(AirymaxRT_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include/agentrt")

# Backwards-compatible alias variables.
set(AirymaxRT_LIBRARIES "")
set(AirymaxRT_INCLUDE_DIR "${AirymaxRT_INCLUDE_DIRS}")

check_required_components(AirymaxRT)
